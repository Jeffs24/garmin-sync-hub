# Copy to .env. Every value is optional.

TZ=UTC
# HUB_PASSWORD=            # protects the web UI with a password (recommended if reachable from outside)

# --- Liftosaur (can also be set in the web UI) ---
# LIFTOSAUR_API_KEY=

# --- Garmin: connect in the web UI. These only allow a login without MFA at startup. ---
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# --- Zwift maps ---
# ZWIFT_AUTO_MERGE=false        # true = merge every detected pair without a click
# ZWIFT_DELETE_SOURCE=true      # delete the Zwift copy on Garmin after merging
# ZWIFT_COPY_ALTITUDE=false     # also copy the Zwift virtual altitude
# ZWIFT_SCAN_DAYS=7
# ZWIFT_SCAN_INTERVAL_MINUTES=30
# ZWIFT_MIN_OVERLAP=0.5
# ZWIFT_MIN_POSITION_RATIO=0.5
# ZWIFT_TIME_TOLERANCE_S=2
# ZWIFT_SOURCE_NAMES=zwift
# ZWIFT_SOURCE_MANUFACTURERS=260
# ZWIFT_EMAIL=                  # automatic Zwift login at startup (or connect in the web UI)
# ZWIFT_PASSWORD=
# ZWIFT_AUTO_SYNC=true          # fetch new Zwift activities at each scan when Zwift is connected
