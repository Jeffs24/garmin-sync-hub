# Copy to .env. Every value is optional.
# Garmin, Liftosaur and Zwift are set up in the web UI (Settings); nothing else goes here.

TZ=UTC
# HUB_PASSWORD=            # protects the web UI with a password (recommended if reachable from outside)

# --- Liftosaur: the API key can also be entered in Settings → Liftosaur ---
# LIFTOSAUR_API_KEY=
